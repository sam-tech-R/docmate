{
  "name": "DocMate - Local Document Workspace",
  "short_name": "DocMate",
  "description": "Private browser-based tools for documents, PDFs, and images.",
  "start_url": "/docmate/",
  "scope": "/docmate/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#020617",
  "background_color": "#020617",
  "icons": [
    {
      "src": "/docmate/icons/docmate.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/docmate/icons/docmate-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
